# 复制为 .env 后填写（bun 自动加载 .env；.env 已被 ignore 不入库）
# 注：引擎连接参数默认 localhost/root/3306/crewforge，非默认环境才需在此覆盖

# 模型 API Key（DeepSeek 直连用；走 sys_settings 设置页时以库中配置优先）
DEEPSEEK_API_KEY=

# MySQL root 密码（Node.ts / task.ts 里读取）—— 唯一强制项，密码禁止入库
DB_PASSWORD=
# 以下三项可选，覆盖引擎连库默认值（阶段2：消灭 host/user/db 硬编码）
DB_HOST=
DB_PORT=
DB_USER=
DB_NAME=

# 产物树根目录（runEnv.ts 读取；空则退回 cwd/runs）
# Java spawn 会显式注入 RUNS_ROOT 指向仓库根 runs/，手工跑可不填
RUNS_ROOT=

# 按阶段起进程模式（EXIT_AT_PHASE_BOUNDARY=1 时每阶段收口即退出，交 Java 对账续拉）
# 手工整跑一个项目请留空；此项由 Java 侧 spawn 默认注入
EXIT_AT_PHASE_BOUNDARY=
