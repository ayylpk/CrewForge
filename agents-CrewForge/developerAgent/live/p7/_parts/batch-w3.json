{
  "type": "architect_batch",
  "projectId": "p7",
  "taskId": "p7-t1",
  "itemId": "w3",
  "detail": "总纲：在 backend/src/routes/users.js 实现 POST /api/users、GET /api/users、GET /api/users/{id}，并在 backend/src/middleware/auth.js 落地 X-User-Id 认证中间件。POST /api/users 作为引导接口必须豁免认证并返回 201；其余两个接口先校验 X-User-Id：缺失、非数字、或用户不存在均返回 401。auth 中间件只把请求头解析出的当前用户放入 req 上下文，绝不读取 body/query 中自称的 userId/author/owner。用户列表返回全部 users，详情按 {id} 查询，不存在返回 404；统一 {data} 与 {error:{message}} 壳，字段 camelCase 且 createdAt 为 ISO 字符串。",
  "checks": [
    {
      "id": "ac-4",
      "kind": "CONTRACT",
      "method": "POST",
      "path": "/api/users",
      "expectedStatus": 201,
      "body": {
        "name": "ac4-user"
      },
      "assertJson": [
        {
          "path": "data.id",
          "exists": true
        },
        {
          "path": "data.name",
          "equals": "ac4-user"
        },
        {
          "path": "data.createdAt",
          "exists": true
        }
      ],
      "expected": "创建用户为引导接口，无需身份即可返回 201 和完整用户对象"
    },
    {
      "id": "ac-5",
      "kind": "CONTRACT",
      "method": "POST",
      "path": "/api/users",
      "expectedStatus": 400,
      "body": {},
      "assertJson": [
        {
          "path": "error.message",
          "exists": true
        }
      ],
      "expected": "缺少必填 name 时返回 400 错误壳"
    },
    {
      "id": "ac-6",
      "kind": "CONTRACT",
      "method": "GET",
      "path": "/api/users",
      "expectedStatus": 401,
      "assertJson": [
        {
          "path": "error.message",
          "exists": true
        }
      ],
      "expected": "缺失 X-User-Id 时用户列表接口必须 401"
    },
    {
      "id": "ac-7",
      "kind": "CONTRACT",
      "method": "GET",
      "path": "/api/users",
      "expectedStatus": 200,
      "resetPaths": [
        "backend/data/team-tasks.db"
      ],
      "setup": [
        {
          "method": "POST",
          "path": "/api/users",
          "body": {
            "name": "list-visible-user"
          },
          "expectedStatus": 201,
          "extract": {
            "name": "id",
            "from": "data.id"
          }
        }
      ],
      "headers": {
        "X-User-Id": "{id}"
      },
      "assertJson": [
        {
          "path": "data",
          "minLength": 1
        },
        {
          "path": "data",
          "each": {
            "path": "name",
            "equals": "list-visible-user"
          }
        }
      ],
      "expected": "从空库造一个用户后，认证用户列表返回且仅返回该用户"
    },
    {
      "id": "ac-8",
      "kind": "CONTRACT",
      "method": "GET",
      "path": "/api/users/{id}",
      "expectedStatus": 200,
      "setup": [
        {
          "method": "POST",
          "path": "/api/users",
          "body": {
            "name": "detail-user"
          },
          "expectedStatus": 201,
          "extract": {
            "name": "id",
            "from": "data.id"
          }
        }
      ],
      "headers": {
        "X-User-Id": "{id}"
      },
      "assertJson": [
        {
          "path": "data.id",
          "exists": true
        },
        {
          "path": "data.name",
          "equals": "detail-user"
        }
      ],
      "expected": "已认证且身份合法时可按 id 读取用户详情"
    },
    {
      "id": "ac-9",
      "kind": "CONTRACT",
      "method": "GET",
      "path": "/api/users",
      "expectedStatus": 401,
      "headers": {
        "X-User-Id": "not-a-real-user-id"
      },
      "assertJson": [
        {
          "path": "error.message",
          "exists": true
        }
      ],
      "expected": "X-User-Id 指向不存在用户时必须 401"
    }
  ]
}