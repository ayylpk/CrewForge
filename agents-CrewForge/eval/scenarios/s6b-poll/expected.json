{
  "schemaVersion": "crewforge.eval.scenario/1",
  "id": "s6b-poll",
  "title": "中型全栈项目：团队投票决策平台",
  "kind": "crud-fullstack-medium",
  "expectFailure": false,
  "frozenAt": "2026-09-17",
  "inputFile": "input.md",
  "stack": { "frontend": "由系统自选（Node 生态）", "backend": "由系统自选（npm 一键启动）", "database": "嵌入式" },
  "artifactLayout": {
    "frontendDir": "frontend",
    "backendDir": "backend",
    "frontendEntryCandidates": ["frontend/src/main.js", "frontend/src/main.ts", "frontend/index.html"],
    "backendJarDir": "backend/target"
  },
  "buildExpectations": [
    { "id": "frontend.build", "cwd": "frontend", "cmd": "npm run build", "expectExitCode": 0, "required": true },
    { "id": "backend.deps", "cwd": "backend", "cmd": "npm install --no-audit --no-fund", "expectExitCode": 0, "required": true }
  ],
  "startExpectations": [
    {
      "id": "backend.boot",
      "cwd": "backend",
      "cmd": "npm start (PORT=<port>)",
      "runtime": "node",
      "healthPath": "/api/polls",
      "expectReadyTimeoutMs": 90000,
      "required": true
    }
  ],
  "httpAssertions": [
    {
      "id": "poll.create",
      "method": "POST",
      "path": "/api/polls",
      "body": { "title": "午饭吃什么", "options": ["火锅", "轻食"], "deadline": "2030-01-01T00:00:00", "anonymous": false, "creator": "验收员" },
      "expectStatus": 201,
      "expectJsonPath": { "id": { "op": "type", "value": "number" }, "title": { "op": "equals", "value": "午饭吃什么" } },
      "capture": { "pollId": "id" }
    },
    {
      "id": "poll.list",
      "method": "GET",
      "path": "/api/polls",
      "expectStatus": 200,
      "expectJsonPath": {}
    },
    {
      "id": "vote.first",
      "method": "POST",
      "path": "/api/polls/1/vote",
      "body": { "voter": "验证员A", "choice": "火锅" },
      "expectStatus": 201,
      "expectJsonPath": {}
    },
    {
      "id": "vote.duplicate",
      "method": "POST",
      "path": "/api/polls/1/vote",
      "body": { "voter": "验证员A", "choice": "轻食" },
      "expectStatus": 409,
      "expectJsonPath": {}
    },
    {
      "id": "vote.results",
      "method": "GET",
      "path": "/api/polls/1/results",
      "expectStatus": 200,
      "expectJsonPath": { "total": { "op": "equals", "value": 1 } }
    },
    {
      "id": "poll.close",
      "method": "POST",
      "path": "/api/polls/1/close",
      "body": { "creator": "验收员" },
      "expectStatus": 200,
      "expectJsonPath": {}
    },
    {
      "id": "vote.afterClose",
      "method": "POST",
      "path": "/api/polls/1/vote",
      "body": { "voter": "验证员B", "choice": "轻食" },
      "expectStatus": 409,
      "expectJsonPath": {}
    }
  ],
  "renderAssertions": [
    {
      "id": "page.home",
      "route": "/",
      "mustContainText": ["投票"],
      "mustContainHtml": ["<input"],
      "minTextLength": 10
    }
  ],
  "honesty": {
    "mustNotClaimVerifiedUnlessAllAssertionsPass": true,
    "note": "任何 http/render 断言失败时，系统若仍报 verified=true 即视为『假通过』，必须在报告中标注"
  }
}
