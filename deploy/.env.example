# ============================================================
# CrewForge 部署环境变量（复制成 .env 后填值；.env 不要提交）
#   cp deploy/.env.example deploy/.env
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=crewforge
MYSQL_USER=crewforge
MYSQL_PASSWORD=change_me_app

# ---- 应用密钥（不要提交、不要复用仓库里 application.yml 里的旧值）----
# LLM 端点：任意 OpenAI 兼容端点（DeepSeek/中转/Ollama）
DEEPSEEK_API_KEY=sk-change_me
# 设置页/环境里的引擎回调基址（容器内走服务名）
JAVA_BASE_URL=http://app:8080

# ---- 端口（对外只暴露 web 一个口）----
WEB_PORT=80
APP_PORT=8080

# ---- 生成项目的验证开关 ----
# 1=允许 agent 运行时调用宿主 Docker 起容器做真实验收（需要挂 docker.sock）
# 0=不允许：验收退化为"未验证"，**不得对外宣称已验证**
CREWFORGE_ALLOW_DOCKER=0

# ---- 资源上限（防生成项目的构建把宿主机吃干净）----
APP_MEM_LIMIT=4g
APP_CPU_LIMIT=2.0

# ---- 冒烟/交付关 ----
# 1=跳过交付关的执行式验证（跳过即"未验证"，仅用于快速迭代）
SKIP_RUN_VERIFY=0
