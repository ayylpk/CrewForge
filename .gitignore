# ===== Java (Maven) =====
**/target/
*.class
*.jar
!**/.mvn/wrapper/maven-wrapper.jar

# ===== Node (Vue) =====
node_modules/
dist/
dist-ssr/
*.local

# ===== IDE =====
.idea/
*.iml
.vscode/

# ===== OS =====
.DS_Store
Thumbs.db

# ===== 日志/临时 =====
*.log
*.tmp
*.pid
smoke-input*
# 前端无测试框架：check-json-merge 靠 tsc 现编 utils/json.ts 到这里的临时产物
.tmp-jsoncheck/

# ===== 敏感配置（本地开发用，不提交；部署时参照 application.example.yml）=====
**/application.yml
**/.env

# ===== 引擎运行产物 =====
# RUNS_ROOT 产物树（pN / _archive / logs 都不入库）
agent/runs/
runs/
# Developer 本机 soft 冒烟的隔离工作区（生成的临时项目 / Ledger / 运行报告都不入库）
.runs/
output/
tmp/

# ===== tsc / vue-tsc 就地 emit 的编译产物 =====
# frontend 的 tsconfig 没关 emit，`vue-tsc -b` 会在源文件旁边生成同名 .js。
# 这不是"会不会发生"：每次类型检查都会生成，`git add -A` 会把它们扫进仓库。
# 用通配而不是写死 frontend/：将来别处同样配置的目录也一并覆盖。
frontend/src/**/*.js
frontend/src/*.js

# ===== 引擎编译产物 =====
**/dist-node/

# ===== developerAgent 实弹实验产物 =====
# 任务包 / 生成出来的实验项目都不入库，整目录挡掉（live/*.ts 因此也一直未入库，
# 这是既有口径，9/19 清理时保持原样，不对它做任何改动）。
agent/engine/developerAgent/live/

# ===== 本地归档（清理时的临时中转，不入库）=====
_archive/
.workbuddy/

# ===== 文档只在本地保留（已入库的 docs/resume、docs/superpowers 不受影响）=====
docs/
